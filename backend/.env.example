GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Postgres connection string (cloud database for accounts).
# Get this free from Neon (neon.tech) or Supabase (supabase.com) —
# both give you a ready-to-paste connection string on their dashboard.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Long, random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Optional: only needed for the forgot-password email to actually send.
# If left blank, reset codes are printed to the server console instead
# (fine for development, not for real users).
# For Gmail: use an "App Password", not your normal password —
# https://support.google.com/accounts/answer/185833
EMAIL_USER=
EMAIL_PASS=

# --- AI phone-call appointment booking (optional feature) -----------
# Get these from twilio.com/console after creating a free account.
# IMPORTANT: Twilio's free trial credit only lets you call phone numbers
# YOU have manually verified in the console, and it plays a "trial
# account" notice before every call. To call a real doctor's office you
# need to upgrade to a pay-as-you-go account — there's no minimum
# spend, and voice calls are typically a few cents per minute, but it
# is not free for calling arbitrary numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A phone number you bought/rented in your Twilio console (E.164 format,
# e.g. +14155551234) — this is who the call appears to come FROM.
TWILIO_FROM_NUMBER=

# A public HTTPS URL where THIS backend can be reached, so Twilio can
# call back into /api/appointment-calls/... while the call is live.
# In production this is your deployed backend's URL. For local testing,
# run `ngrok http 3000` and paste the https://*.ngrok-free.app URL here.
PUBLIC_BASE_URL=
